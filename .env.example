# --- Base de données -------------------------------------------------------
# PostgreSQL : postgresql://UTILISATEUR:MOTDEPASSE@HOTE:5432/BASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zekatech"

# --- NextAuth --------------------------------------------------------------
# URL publique du site (sans slash final)
NEXTAUTH_URL="http://localhost:3000"
# Secret de signature des sessions : openssl rand -base64 32
NEXTAUTH_SECRET=""

# URL publique utilisée pour les metadata SEO, le sitemap et robots.txt
# (par défaut : NEXTAUTH_URL)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Cloudinary (médias des projets) ---------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Emails (Resend) -------------------------------------------------------
# Sans RESEND_API_KEY, le lien de réinitialisation n'est pas envoyé.
RESEND_API_KEY=""
FROM_EMAIL="ZekaTech <no-reply@exemple.com>"

# --- Seed (npm run db:seed) ------------------------------------------------
# ADMIN_PASSWORD est OBLIGATOIRE en production (le seed échoue sinon).
ADMIN_EMAIL="admin@zekatech.com"
ADMIN_PASSWORD=""
